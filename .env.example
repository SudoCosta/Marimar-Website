# URL canónica pública, sem barra final
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contactos públicos — deixar vazio para ocultar o respetivo elemento
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_SCHEDULE=

# Endpoint HTTPS externo que recebe POST JSON e devolve { "id": "..." }.
# É necessário para ativar o formulário num alojamento estático como GitHub Pages.
NEXT_PUBLIC_LEADS_ENDPOINT=

# Receção server-side de pedidos por Resend
RESEND_API_KEY=
LEADS_TO_EMAIL=
FROM_EMAIL=
